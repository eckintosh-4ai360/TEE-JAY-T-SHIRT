generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  PRINTING // displays as "In Progress" for photography
  COMPLETED
  DELIVERED
  CANCELLED
}

enum UserRole {
  ADMIN
  WORKER
}

enum ServiceCategory {
  PRINTING
  PHOTOGRAPHY
}

enum PrintingType {
  TSHIRT
  LACOSTE
  LOGO
  POSTER
  FLYER
  OTHER
}

enum PhotographyType {
  WEDDING
  BIRTHDAY
  GRADUATION
  OTHER
}

// ── Models ──────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  role         UserRole @default(WORKER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedOrders Order[]

  @@index([email])
  @@index([role])
}

model Order {
  id            String   @id @default(cuid())
  receiptNumber String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // ── Service type ──────────────────────────────────────────────────────────
  serviceCategory      ServiceCategory  @default(PRINTING)
  printingType         PrintingType?
  printingTypeOther    String?
  photographyType      PhotographyType?
  photographyTypeOther String?

  // ── Client information ────────────────────────────────────────────────────
  clientName  String
  clientPhone String?
  clientEmail String?

  // ── Worker assignment ─────────────────────────────────────────────────────
  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id])

  // ── Order details ─────────────────────────────────────────────────────────
  description String? // design brief / photography details
  dueDate     DateTime?
  status      OrderStatus @default(PENDING)
  notes       String?

  // ── Pricing ───────────────────────────────────────────────────────────────
  unitPrice   Decimal @db.Decimal(12, 2)
  totalQty    Int     @default(1)
  totalAmount Decimal @default(0) @db.Decimal(12, 2)
  amountPaid  Decimal @default(0) @db.Decimal(12, 2)
  balance     Decimal @default(0) @db.Decimal(12, 2)

  // ── Colour breakdown (printing only) ──────────────────────────────────────
  sizes  Json?
  colors OrderColor[]

  @@index([status])
  @@index([createdAt])
  @@index([clientName])
  @@index([receiptNumber])
  @@index([serviceCategory])
  @@index([assignedToId])
}

model OrderColor {
  id   String @id @default(cuid())
  name String
  qty  Int    @default(0)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}
