// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection URL — used at runtime (PgBouncer via Neon)
  url       = env("DATABASE_URL")
  // Direct (unpooled) connection URL — used for migrations only
  directUrl = env("DIRECT_URL")
}

enum OrderStatus {
  PENDING
  PRINTING
  COMPLETED
  DELIVERED
  CANCELLED
}

enum UserRole {
  ADMIN
  WORKER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(WORKER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
}

model Order {
  id          String      @id @default(cuid())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Client information
  clientName  String
  clientPhone String?
  clientEmail String?

  // Order details
  design      String?
  dueDate     DateTime?
  status      OrderStatus @default(PENDING)
  notes       String?

  // Pricing — using Decimal for accurate money arithmetic
  unitPrice   Decimal     @db.Decimal(12, 2)
  totalQty    Int         @default(0)
  totalAmount Decimal     @db.Decimal(12, 2) @default(0)
  amountPaid  Decimal     @db.Decimal(12, 2) @default(0)
  balance     Decimal     @db.Decimal(12, 2) @default(0)

  // Relation to individual colour + quantity breakdown
  colors      OrderColor[]

  @@index([status])
  @@index([createdAt])
  @@index([clientName])
}

model OrderColor {
  id      String @id @default(cuid())
  name    String
  qty     Int    @default(0)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}
